#!/bin/env bash

KST_Version="26.09_r4"
KST_BackupFile="KST_ConfigBackup.conf"
KST_Today="$(date +%Y%m%d)"

###########################################################################################################################################
# Display Functions #                                                                                                                     #
###########################################################################################################################################

function NewLine() {
    echo " "
}

function DisplayLine() {
    echo "------------------------------------------------------------------"
}

function NewLineCinema() {
    NewLine
    DisplayLine
    NewLine
}


function KSecurity_DisplayBanner() {
	echo "KSecurityTool - Version $KST_Version."
	echo "-------------------------------------"
	echo "BackupFile: $KST_BackupFile-$KST_Today"
	echo " "
}

function CheckRoot() {
if [ $(whoami) = 'root' ]; then
	echo "${green} You are root. ${reset}"
else
	echo "${green} You are not root! ${reset}"
fi
}

function SudoWrapper() {
  # Check if the effective user ID (EUID) is 0 (root)
  if [ "$EUID" -ne 0 ]; then
    SUDO="sudo"
  else
    SUDO=""
  fi

  # Execute the command passed as the first argument ($1)
  $SUDO "$1"
}

###########################################################################################################################################
# Check_bpf_jit_harden.sh #                                                                                                               #
###########################################################################################################################################

function Check_bpf_jit_harden() {
## IMPORTANT: Needs Root!

echo "#####################################"
echo "---------- bpf_jit_harden ----------"
echo "#####################################"
echo " "

# Configuration #
    BPF_PROC_PATH="/proc/sys/net/core/bpf_jit_harden"
    BPF_SYSCTL_KEY="net.core.bpf_jit_harden"

# 1. Check runtime value in /proc
    if [ ! -f "$BPF_PROC_PATH" ]; then
        echo "${red} ERROR: BPF JIT compilation or proc entry not found on this kernel. ${reset}"
        return 1
    fi

	### INFO: Root Fix
    ### BPF_RUNTIME_VAL=$(cat "$BPF_PROC_PATH")
	BPF_RUNTIME_VAL=$(sudo cat "$BPF_PROC_PATH")

    # 2. Determine runtime security status
    # 0 = Disabled (Not Secure)
    # 1 = Hardening for unprivileged users only (Partially Secure)
    # 2 = Hardening for all users (Fully Secure / Recommended)
    if [ "$BPF_RUNTIME_VAL" -eq 2 ]; then
        BPF_RUNTIME_STATUS="SECURE (Fully hardened for all users)"
    elif [ "$BPF_RUNTIME_VAL" -eq 1 ]; then
        BPF_RUNTIME_STATUS="PARTIALLY SECURE (Hardened for unprivileged users only)"
    else
        BPF_RUNTIME_STATUS="NOT SECURE (Hardening disabled)"
    fi

    echo "--- Runtime Status ---"
    echo "Current value in proc: $BPF_RUNTIME_VAL ($BPF_RUNTIME_STATUS)"

    # 3. Check persistent configuration files
    echo -e "\n--- Config File Status ---"

    # Grab the final evaluation of sysctl configs as systemd sees them
    BPF_CONFIG_VAL=$(sysctl --cat-config 2>/dev/null | grep -E -v '^(#|;)' | grep "$BPF_SYSCTL_KEY" | tail -n 1 | awk -F'=' '{print $2}' | tr -d ' ')

    if [ -z "$BPF_CONFIG_VAL" ]; then
        echo "${red} Result: NOT SECURE. No persistent setting found for '$BPF_SYSCTL_KEY' in configuration files. ${reset}"
        echo "Default kernel configuration will apply on reboot."
    else
        if [ "$BPF_CONFIG_VAL" -eq 2 ]; then
            echo "${green} Result: SECURE. Persistent configuration defines '$BPF_SYSCTL_KEY = 2'. ${reset} "
        elif [ "$BPF_CONFIG_VAL" -eq 1 ]; then
            echo "${orange} Result: PARTIALLY SECURE. Persistent configuration defines '$BPF_SYSCTL_KEY = 1'. ${reset} "
        else
            echo "${red} Result: NOT SECURE. Persistent configuration explicitly disables hardening ('$BPF_SYSCTL_KEY = 0'). ${reset} "
        fi
    fi
}

###########################################################################################################################################
# Check_kptr_restrict.sh #                                                                                                                #
###########################################################################################################################################

function Check_kptr_restrict() {

echo "#####################################"
echo "---------- kptr_restrict ----------"
echo "#####################################"
echo " "

# Configuration and target definitions
    KPTR_CONFIG_FILE="conf/kptr_restrict.conf"
    KPTR_PROC_FILE="/proc/sys/kernel/kptr_restrict"

# 1. Verify the /proc entry exists
    if [ ! -f "$KPTR_PROC_FILE" ]; then
        echo "${red} ERROR: $KPTR_PROC_FILE not found. Is this a Linux system? ${reset} "
        return 2
    fi

# 2. Verify and parse the configuration file
    if [ ! -f "$KPTR_CONFIG_FILE" ]; then
        echo "${red} ERROR: Configuration file '$KPTR_CONFIG_FILE' missing. ${reset} "
        return 2
    fi

# Safely extract expected value using grep/awk instead of sourcing the file
    KPTR_EXPECTED_VALUE=$(grep -E '^kernel\.kptr_restrict[[:space:]]*=' "$KPTR_CONFIG_FILE" | awk -F'=' '{print $2}' | tr -d '[:space:]')

    if [ -z "$KPTR_EXPECTED_VALUE" ]; then
        echo "${red} ERROR: 'kernel.kptr_restrict' not defined in $KPTR_CONFIG_FILE. ${reset} "
        return 2
    fi

# 3. Read the live system state
    KPTR_CURRENT_VALUE=$(cat "$KPTR_PROC_FILE")

# 4. Evaluate compliance and determine if secure
# Note: Security standards usually dictate a value of '1' or '2'
    if [ "$KPTR_CURRENT_VALUE" -eq "$KPTR_EXPECTED_VALUE" ]; then
        if [ "$KPTR_CURRENT_VALUE" -gt 0 ]; then
            echo "${green} [ SECURE ] ${reset} "
            return 0
        else
            echo "${red} [ NOT SECURE ] {reset}  (System matches config, but kptr_restrict is disabled [0])"
            return 1
        fi
    else
        echo "${red} [ NOT SECURE ] ${reset} (System value '$KPTR_CURRENT_VALUE' does not match config target '$KPTR_EXPECTED_VALUE')"
        return 1
    fi
}

###########################################################################################################################################
# Check_ptrace_scope.sh #                                                                                                                 #
###########################################################################################################################################

function Check_ptrace_scope() {

echo "#####################################"
echo "---------- ptrace_scope ----------"
echo "#####################################"
echo " "

# Paths
    PTRACE_PROC_FILE="/proc/sys/kernel/yama/ptrace_scope"
    PTRACE_CONFIG_FILE="conf/ptrace.conf"

# Ensure proc file exists (Yama LSM must be enabled)
    if [ ! -f "$PTRACE_PROC_FILE" ]; then
        echo "${red} ERROR: $PTRACE_PROC_FILE not found. Yama security module might be disabled. ${reset} "
        return 1
    fi

# Ensure config file exists
    if [ ! -f "$PTRACE_CONFIG_FILE" ]; then
        echo "${red} ERROR: Configuration file '$PTRACE_CONFIG_FILE' missing. ${reset} "
        return 1
    fi

# 1. Read current runtime value from /proc
    current_value=$(cat "$PTRACE_PROC_FILE")

# 2. Source the config file to read minimum secure threshold
# Expected format inside ptrace.conf: MIN_SECURE_LEVEL=1
    source "$PTRACE_CONFIG_FILE"

    if [ -z "$PTRACE_MIN_SECURE_LEVEL" ]; then
        echo "${red} ERROR: PTRACE_MIN_SECURE_LEVEL is not defined in $PTRACE_CONFIG_FILE. ${reset} "
        return 1
    fi

# 3. Evaluate and return result
    echo " PTRACE SCOPE STATUS ----------"
    echo "  Current Runtime Value: $current_value  "
    echo "  Configured Threshold:  $PTRACE_MIN_SECURE_LEVEL  "
    echo "-------------------------------"

    if [ "$current_value" -ge "$PTRACE_MIN_SECURE_LEVEL" ]; then
        echo "  STATUS: ${green} [ SECURE ] ${reset} "
        return 0
    else
        echo "  STATUS: ${red} [ NOT SECURE ] ${reset} "
        return 1
    fi
}







